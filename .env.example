# ── API Keys ───────────────────────────────────────────────
# Ocean.io  — Account Settings → API Tokens
OCEAN_API_TOKEN=your_ocean_api_token_here

# Prospeo   — https://app.prospeo.io/api
PROSPEO_API_KEY=your_prospeo_api_key_here

# Eazyreach — Dashboard → API Settings
EAZYREACH_API_KEY=your_eazyreach_api_key_here

# Brevo     — https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your_brevo_api_key_here

# ── Sender Info ────────────────────────────────────────────
SENDER_EMAIL=you@yourdomain.com
SENDER_NAME=Your Name
